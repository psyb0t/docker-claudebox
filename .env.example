# claudebox — example env for `docker run --env-file`.
#
# CLAUDEBOX_* is canonical for v2+; the entrypoint aliases each to its
# AICODEBOX_* equivalent when the target is unset. AICODEBOX_* wins if both
# are set (power-user override). Legacy CLAUDE_MODE_* names are also aliased
# forward for compat with pre-v2 configs.

# ── Auth (Anthropic / third-party) ───────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional third-party gateway
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# ── Mode flags — pick one foreground + optional MCP ──────────────────────────
CLAUDEBOX_API_MODE=
CLAUDEBOX_TELEGRAM_MODE=
CLAUDEBOX_CRON_MODE=
CLAUDEBOX_MCP_MODE=

# ── API mode ─────────────────────────────────────────────────────────────────
CLAUDEBOX_API_MODE_PORT=8080
CLAUDEBOX_API_MODE_TOKEN=
# CSV list surfaced at /openai/v1/models — required for API mode to boot.
CLAUDEBOX_AVAILABLE_MODELS=haiku,sonnet,opus,opusplan

# ── Telegram mode ────────────────────────────────────────────────────────────
CLAUDEBOX_TELEGRAM_MODE_TOKEN=
CLAUDEBOX_TELEGRAM_MODE_CONFIG=/home/aicode/.aicodebox/telegram.yml
CLAUDEBOX_TELEGRAM_MODE_OVERRIDES=/home/aicode/.aicodebox/telegram_overrides.json

# ── Cron mode ────────────────────────────────────────────────────────────────
CLAUDEBOX_CRON_MODE_FILE=
CLAUDEBOX_CRON_MODE_HISTORY_DIR=/home/aicode/.aicodebox/cron/history

# ── MCP mode ─────────────────────────────────────────────────────────────────
CLAUDEBOX_MCP_MODE_PORT=8081
CLAUDEBOX_MCP_MODE_TOKEN=

# ── Runtime ──────────────────────────────────────────────────────────────────
CLAUDEBOX_WORKSPACE=/workspace
CLAUDEBOX_CONTAINER_NAME=claudebox
CLAUDEBOX_IMAGE_VARIANT=minimal
# Where the adapter scans for SKILL.md files on every call.
CLAUDEBOX_ALWAYS_SKILLS_DIR=/home/aicode/.claude/.always-skills
# Prepended to --append-system-prompt on every call (defaults are seeded by
# init.d on first boot).
CLAUDEBOX_SYSTEM_HINT_FILE=/home/aicode/.claude/system-hint.txt
